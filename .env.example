# Connection string for a WRITE account — loading does INSERTs, so a read-only account cannot do it.
#  ★ The account you give SoriTrading is the other one: a READ-ONLY account (readonly_bot).
#  ★ .env is gitignored. This file is only an example and holds no secret.
#
#  Supabase direct:  postgres://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
#  Supabase pooler:  postgres://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres
