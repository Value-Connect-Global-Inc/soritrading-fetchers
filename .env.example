# 쓰기 계정 연결 문자열 — 수집은 INSERT 를 하므로 읽기 전용 계정으로는 안 된다.
#  ★ 소리트레이딩에 주는 건 이 계정이 아니라 **읽기 전용 계정**(readonly_bot)이다.
#  ★ .env 는 커밋하지 않는다(.gitignore 에 있다). 이 파일은 예시일 뿐 비밀이 없다.
#
#  Supabase 직결:   postgres://postgres:비밀번호@db.<프로젝트ref>.supabase.co:5432/postgres
#  Supabase 풀러:   postgres://postgres.<프로젝트ref>:비밀번호@aws-0-<리전>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:비밀번호@호스트:5432/postgres
